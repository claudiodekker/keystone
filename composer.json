{
    "name": "claudiodekker/keystone-monorepo",
    "description": "The Keystone packages for Laravel, developed together.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "nikic/php-parser": "^5.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3"
    },
    "replace": {
        "claudiodekker/keystone": "self.version"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "autoload": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\": "packages/keystone/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\Tests\\": "tests/"
        },
        "files": [
            "lint.php"
        ]
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G packages/*/src",
            "pest",
            "@composer audit"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
