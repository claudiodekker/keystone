{
    "name": "claudiodekker/keystone-monorepo",
    "description": "The Keystone packages for Laravel, developed together.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "nikic/php-parser": "^5.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3"
    },
    "replace": {
        "claudiodekker/keystone": "self.version"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "autoload": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\": "packages/keystone/src/",
            "ClaudioDekker\\Keystone\\Database\\Factories\\": "packages/keystone/database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\AppTests\\": "packages/keystone/app-tests/",
            "ClaudioDekker\\Keystone\\Lint\\": "lint/",
            "ClaudioDekker\\Keystone\\Tests\\": [
                "tests/",
                "packages/keystone/tests/"
            ]
        }
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G packages/*/src packages/*/tests/Fixtures",
            "pest",
            "@composer audit"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
