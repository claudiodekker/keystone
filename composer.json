{
    "name": "claudiodekker/keystone-monorepo",
    "description": "The Keystone packages for Laravel, developed together.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "claudiodekker/keystone-inertia-vue": "self.version",
        "claudiodekker/keystone-password": "self.version",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "nikic/php-parser": "^5.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "replace": {
        "claudiodekker/keystone": "self.version"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "autoload": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\": "packages/keystone/src/",
            "ClaudioDekker\\Keystone\\Database\\Factories\\": "packages/keystone/database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "packages/keystone-inertia-vue/stubs/app/",
            "ClaudioDekker\\Keystone\\AppTests\\": "packages/keystone/app-tests/",
            "ClaudioDekker\\Keystone\\InertiaVue\\AppTests\\": "packages/keystone-inertia-vue/app-tests/",
            "ClaudioDekker\\Keystone\\Lint\\": "lint/",
            "ClaudioDekker\\Keystone\\Password\\AppTests\\": "packages/keystone-password/app-tests/",
            "ClaudioDekker\\Keystone\\Tests\\": [
                "tests/",
                "packages/keystone/tests/"
            ],
            "Tests\\Keystone\\": "packages/keystone-inertia-vue/stubs/tests/Keystone/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "post-install-cmd": "git config core.hooksPath .githooks",
        "check": [
            "@composer validate --strict",
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G packages/*/src packages/*/tests/Fixtures packages/*/stubs/app workbench/app",
            "npm run check",
            "pest",
            "@putenv KEYSTONE_ADAPTER=keystone-inertia-vue",
            "pest packages/*/app-tests",
            "@composer audit",
            "npm audit"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
