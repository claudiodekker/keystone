{
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "node -e \"require('vue-tsc').run(require.resolve('@typescript/typescript6/lib/tsc'))\"",
        "check": "npm run typecheck && vitest run --passWithNoTests && vite build && prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vitest": "^5.0.2",
        "vue": "^3.5.43",
        "vue-tsc": "^3.3.11"
    }
}
