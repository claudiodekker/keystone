{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "vite build --config workbench/vite.config.ts",
    "check": "npm run build && vue-tsc --noEmit && prettier --check package.json tsconfig.json \"packages/*/package.json\" \"packages/*/stubs/**/*.{ts,vue,json,css}\" workbench"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3",
    "@types/node": "^26",
    "laravel-vite-plugin": "^3.2",
    "prettier": "^3.9",
    "prettier-plugin-organize-imports": "^4.3",
    "prettier-plugin-tailwindcss": "^0.8",
    "tailwindcss": "^4.3",
    "typescript": "^6",
    "vite": "^8.3"
  }
}
