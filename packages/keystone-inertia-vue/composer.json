        "laravel/framework": "^13.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "autoload": {
        "psr-4": {
            "ClaudioDekker\\Keystone\\InertiaVue\\": "src/"
        }
    },
    "extra": {
