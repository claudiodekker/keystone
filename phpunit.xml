<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
>
    <testsuites>
        <testsuite name="app-tests">
            <directory>packages/keystone/app-tests</directory>
            <exclude>packages/keystone/app-tests/Contract</exclude>
        </testsuite>
        <testsuite name="contract">
            <directory>packages/keystone/app-tests/Contract</directory>
        </testsuite>
        <testsuite name="keystone">
            <directory>packages/keystone/tests</directory>
        </testsuite>
        <testsuite name="keystone-inertia-vue">
            <directory>packages/keystone-inertia-vue/tests</directory>
        </testsuite>
        <testsuite name="keystone-password">
            <directory>packages/keystone-password/app-tests</directory>
            <directory>packages/keystone-password/tests</directory>
        </testsuite>
        <testsuite name="tooling">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:iO0Xn7B30kWbdkuR2r8eRk0EXwfrXFfXcRAJCU6AXrs="/>
        <env name="ARGON_MEMORY" value="64"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
